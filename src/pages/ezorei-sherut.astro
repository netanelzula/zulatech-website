---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="אזורי שירות - חדרה, השרון, חיפה והמרכז | Zulatech"
  description="Zulatech נותנת שירות בחדרה והסביבה, חיפה, השרון והמרכז - מחשבים, תקשורת, חשמל ומצלמות אבטחה."
>
<section id="hero" class="hero">
  <div class="wrap">
    <div class="hero-card glass reveal">
      <span class="hero-tag">אזורי שירות</span>
      <h1 style="font-size:clamp(30px,4.4vw,46px);color:var(--navy);font-weight:600;margin:22px 0 6px">מחדרה<br><span style="color:var(--blue)">ועד לכל אזורי השירות</span></h1>
      <div class="hero-lines">
        <p>חדרה היא הבסיס שממנו אני יוצא, אבל השירות לא נעצר שם.</p>
        <p>מעבדת מחשבים, תקשורת, חשמל ומצלמות אבטחה - בחדרה, השרון, המרכז וחיפה.</p>
      </div>
      <div class="hero-ctas">
        <a href="tel:+972544202284" class="btn btn-primary">
          <svg viewBox="0 0 24 24" stroke="#fff" fill="none" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          חייגו: 054-420-2284
        </a>
        <a href="https://wa.me/972544202284" target="_blank" rel="noopener" class="btn">
          <svg viewBox="0 0 24 24" fill="var(--wa)"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88M20.46 3.48A11.82 11.82 0 0 0 12.05 0C5.49 0 .16 5.34.15 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.4"/></svg>
          וואטסאפ
        </a>
      </div>
      <div class="badges">
        <span class="badge">טכנאי מחשבים</span>
        <span class="badge">CCNA</span>
        <span class="badge">חשמלאי בעל רישיון</span>
      </div>
      <div class="stats-row" style="margin-top:26px;padding-top:22px;border-top:1px solid var(--hair);display:flex;gap:34px;justify-content:center;flex-wrap:wrap">
        <div class="stat"><div class="num">20</div><div class="lbl">שנות ניסיון</div></div>
        <div class="stat"><div class="num">★5.0</div><div class="lbl">דירוג בגוגל</div></div>
        <div class="stat"><div class="num">4</div><div class="lbl">אזורי שירות</div></div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="hadera">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow" id="areasHeadline">האזור העיקרי</div>
      <h2>חדרה והסביבה</h2>
      <p>20 שנה שאני נותן שירות בחדרה, זכרון יעקב, גבעת עדה ופרדס חנה - עם מגוון פרויקטים לאורך הדרך.</p>
    </div>
    <div class="gal-grid">
      <div class="g-item reveal"><img src="/images/network-cabinet-labeled-office-hadera.webp" alt="ארון תקשורת מתויג במשרד בחדרה"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">ארון תקשורת מתויג</span></div></div>
      <div class="g-item reveal"><img src="/images/gaming-pc-build-hadera.webp" alt="הרכבת מחשב גיימינג במעבדה בחדרה"><div class="g-cap"><span class="cat">מעבדת מחשבים</span><span class="ttl">הרכבת מחשב גיימינג</span></div></div>
      <div class="g-item reveal"><img src="/images/security-camera-office-hadera.webp" alt="מצלמות אבטחה במשרדים בחדרה"><div class="g-cap"><span class="cat">אבטחה</span><span class="ttl">מצלמת אבטחה</span></div></div>
      <div class="g-item reveal"><img src="/images/electrical-outlet-relocation-hadera.webp" alt="הזזת שקע חשמל בחדרה"><div class="g-cap"><span class="cat">חשמל</span><span class="ttl">הזזת שקע חשמל</span></div></div>
      <div class="g-item reveal"><img src="/images/light-switch-replacement-hadera.webp" alt="החלפת מפסקים בחדרה"><div class="g-cap"><span class="cat">חשמל</span><span class="ttl">החלפת מפסקים</span></div></div>
      <div class="g-item reveal"><img src="/images/network-outlet-wiring-kfar-haroe.webp" alt="חיווט שקע רשת בכפר הרואה"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">כפר הרואה</span></div></div>
      <div class="g-item reveal"><img src="/images/cable-clutter-before-zichron-yaakov.webp" alt="כבלים לפני סידור תקשורת וחשמל בחנות בזכרון יעקב"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">לפני סידור - זכרון יעקב</span></div></div>
      <div class="g-item reveal"><img src="/images/network-cabinet-after-zichron-yaakov.webp" alt="ארון תקשורת מסודר לאחר התקנה בחנות בזכרון יעקב"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">אחרי סידור - זכרון יעקב</span></div></div>
    </div>
  </div>
</section>

<section class="section" id="haifa">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">גם כאן</div>
      <h2>חיפה והסביבה</h2>
      <p>פרויקטים מגוונים שביצעתי בחנויות ברחבי חיפה.</p>
    </div>
    <div class="gal-grid">
      <div class="g-item reveal"><img src="/images/network-rack-installation-haifa.webp" alt="התקנת ארון תקשורת מקצועי בחנות בחיפה"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">ארון תקשורת - חיפה</span></div></div>
      <div class="g-item reveal"><img src="/images/network-installation-collage-castra-haifa.webp" alt="התקנת מערכת תקשורת מלאה בחנות בקסטרא, חיפה"><div class="g-cap"><span class="cat">תקשורת</span><span class="ttl">התקנה מלאה - קסטרא, חיפה</span></div></div>
    </div>
  </div>
</section>

<section class="section" id="sharon">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">גם כאן</div>
      <h2>השרון</h2>
      <p>מגיע לנתניה, כפר סבא והרצליה.</p>
    </div>
    <div class="areas-row reveal">
      <div class="area-chip glass glass-sm"><b>נתניה</b><span>ומרכז הישוב</span></div>
      <div class="area-chip glass glass-sm"><b>כפר סבא</b><span>ואזורי התעשייה</span></div>
      <div class="area-chip glass glass-sm"><b>הרצליה</b><span>ואזורי התעשייה</span></div>
    </div>
  </div>
</section>

<section class="section" id="merkaz">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">גם כאן</div>
      <h2>מרכז</h2>
      <p>מכסים גם את אזור המרכז, בתיאום מראש.</p>
    </div>
    <div class="areas-row reveal">
      <div class="area-chip glass glass-sm"><b>תל אביב</b><span>וישובי הסביבה</span></div>
      <div class="area-chip glass glass-sm"><b>רמת גן</b><span>וישובי הסביבה</span></div>
      <div class="area-chip glass glass-sm"><b>ראשון לציון</b><span>וישובי הסביבה</span></div>
      <div class="area-chip glass glass-sm"><b>פתח תקווה</b><span>וישובי הסביבה</span></div>
    </div>
  </div>
</section>

<section class="section" id="contact">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">יצירת קשר</div>
      <h2>נמצאים באחד מאזורי השירות? בואו נדבר</h2>
