---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import { site } from "../data/site";

const demoFaq = [
  { q: "כמה עולה תיקון מחשב?", a: "אין מחיר אחיד, כי הכל תלוי בסוג התקלה ובחלקים שצריך להחליף. מה שכן קבוע: אני בודק, מסביר בדיוק מה מצאתי ומה צריך ונותן מחיר סופי עוד לפני שאני מתחיל." },
  { q: "כמה זמן לוקח תיקון?", a: "תלוי בתקלה ובזמינות החלקים. תקלות פשוטות נסגרות מהר והרכבת מחשב חדש מוכנה בדרך כלל עד 3 ימי עסקים." },
  { q: "חובה שחשמלאי יהיה בעל רישיון?", a: "כן. עבודות חשמל מחייבות רישיון לפי חוק וזה לא עניין פורמלי אלא בטיחות. אני חשמלאי בעל רישיון רשמי." },
];
---

<BaseLayout
  title="Zulatech - חדרה, השרון וחיפה | מחשבים, תקשורת, חשמל ומצלמות"
  description="Zulatech - מעבדת מחשבים, תקשורת ורשתות, חשמל ומצלמות אבטחה. חדרה, השרון וחיפה."
>
  <section class="px-4 py-10">
    <div class="mx-auto max-w-[1140px]">
      <div class="glass reveal px-8 py-14 text-center">
        <span class="mb-5 inline-block rounded-full border border-[rgba(47,128,245,.3)] bg-[rgba(47,128,245,.08)] px-4 py-1.5 text-[13px] font-bold text-[var(--color-brand-blue)]">
          תשתית 3א + 3ב
        </span>
        <h1 class="mb-2 text-[clamp(30px,4.4vw,46px)] text-[var(--color-brand-blue)]">
          העסק והבית שלך<br /><span class="text-[var(--color-brand-sky)]">בידיים טובות</span>
        </h1>
        <p class="mx-auto mb-6 max-w-xl text-[var(--color-ink-dim)]">
          עמוד בדיקה זמני. משמש לאימות שהתשתית והרכיבים המשותפים עובדים.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={site.phoneHref} class="btn btn-primary">חייגו: {site.phone}</a>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn">וואטסאפ</a>
        </div>
        <div class="mt-7 flex flex-wrap justify-center gap-2">
          {site.badges.map((b) => (
            <span class="rounded-full border border-[var(--hair)] bg-white/60 px-4 py-1.5 text-[13px] text-[var(--color-navy)]">{b}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-10">
    <div class="mx-auto grid max-w-[1140px] gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {["מעבדת מחשבים", "תקשורת ורשתות", "חשמל", "מצלמות אבטחה"].map((s) => (
        <div class="glass-sm is-clickable reveal border border-white/60 p-7">
          <h3 class="mb-2 text-[18px]">{s}</h3>
          <p class="text-[14px] text-[var(--color-ink-dim)]">בדיקת רכיב כרטיס עם אפקט זכוכית ומצב לחיץ.</p>
        </div>
      ))}
    </div>
  </section>

  <Faq items={demoFaq} />

  <section class="px-4 py-10" id="contact">
    <div class="mx-auto max-w-[1140px] text-center">
      <h2 class="mb-3 text-[clamp(22px,3vw,30px)]">יצירת קשר</h2>
      <p class="text-[var(--color-ink-dim)]">עוגן לבדיקת ניווט - {site.address}</p>
    </div>
  </section>

  <div class="h-[60vh]"></div>
</BaseLayout>
